{
  "appId": "com.sinsera.gossoko",
  "appName": "Gossoko",
  "webDir": "www",
  "server": {
    "url": "https://sinsera.co/gossoko/admin/",
    "errorPath": "offline.html",
    "allowNavigation": [
      "sinsera.co",
      "*.sinsera.co",
      "*.supabase.co",
      "127.0.0.1",
      "localhost"
    ]
  },
  "backgroundColor": "#0a0908",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0a0908"
  },
  "android": {
    "backgroundColor": "#0a0908"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SystemBars": {
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    }
  }
}
