# Gossoko (Peta, 14 Nov 2026): /gossoko/ = the website, /gossoko/admin/ = the app, /gossoko/login/ = sign-in.
AddType application/manifest+json .webmanifest
AddType application/vnd.android.package-archive .apk

RewriteEngine On
RewriteBase /gossoko/
# Real files and folders (the website, assets, about/business/privacy/terms, login/, admin/) as they are.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# The old About address is the website's front page now.
RewriteRule ^about/?$ /gossoko/ [R=301,L]
# Any app route: serve the app.
RewriteRule ^admin/ /gossoko/admin/index.html [L]
# Old staff pages lived at /gossoko/admin/<page>; old app links (emails, alerts, bookmarks, the
# installed phone apps) lived at /gossoko/<route>. Send them into the app; the #hash survives.
RewriteRule ^(.+)$ /gossoko/admin/$1 [R=302,L,QSA]

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://tiles.openfreemap.org; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
  # HTML and the manifest are never cached, so a new deploy is picked up at once.
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
