{
  "name": "gossoko",
  "version": "0.2.0",
  "description": "Gossoko - Community review platform (web, phone and tablet)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "python3 scripts/make_icons.py",
    "sim": "sim/run.sh",
    "deploy": "npm test && npm run build && python3 scripts/deploy.py",
    "release-check": "RELEASE_CHECK=1 vitest run tests/unit/legalRelease.test.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@fontsource/archivo-black": "^5.3.0",
    "@supabase/supabase-js": "^2.106.0",
    "isomorphic-dompurify": "^3.13.0",
    "maplibre-gl": "^5.24.1",
    "qrcode-generator": "^1.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "typescript": "^5.0.0",
    "vite": "^5.4.8",
    "vitest": "^1.0.0"
  }
}
